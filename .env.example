# Shared secret Overland must send as "Authorization: Bearer <value>".
# Make this up yourself (any long random string) - it isn't issued by Overland or Discord.
OVERLAND_ACCESS_TOKEN=change-me-to-a-long-random-string

# Quote Bot's existing token, reused here for sending the split-notification DM.
DISCORD_BOT_TOKEN=

# Your own Discord user ID (right-click your name in Discord with Developer Mode on).
DISCORD_USER_ID=

# Testing toggle: "true" sends a DM every TEST_MODE_INTERVAL_SECONDS instead
# of only at real half-mile/mile checkpoints, for validating pace math in
# small increments. This is just the startup default - flip it live and
# password-protected from the dashboard's Admin panel instead of editing this.
DISCORD_TEST_MODE=false
TEST_MODE_INTERVAL_SECONDS=15

# Password required by the dashboard's Admin panel to flip test mode on/off
# live (and any future admin/testing controls) without a Railway restart.
TEST_MODE_PASSWORD=change-me-to-something-only-you-know
